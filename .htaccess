DirectoryIndex index.php

<IfModule mod_headers.c>
    Header set Cache-Control "no-store, no-cache, must-revalidate"
    Header set X-Content-Type-Options "nosniff"
</IfModule>

# Fichiers sensibles ou techniques : jamais servis par le web
# (scripts SQL, cookies/sessions de test, composer, config des tests, dépendances)
<FilesMatch "(^tmp_.*\.txt|\.(sql|lock|phar|md)|^composer(-setup)?\.(json|php)|^phpunit\.xml|^\.gitignore)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
